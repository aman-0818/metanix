# Copy this file to `.env` and fill in real values. Never commit `.env` itself.

# Shows/hides the "Sign in with Azure AD" button on the login screen.
# Must match the backend's AZURE_AD_ENABLED (backend/.env) — this flag only
# controls the button; the backend flag is what actually enables the
# azure/authorize and azure/token endpoints. Azure Portal setup itself is
# all on the backend side (see backend/.env.example) — nothing Azure-specific
# is configured here beyond this toggle.
VITE_AZURE_AD_ENABLED=false
