# Root-level overrides for docker-compose.yml's Postgres credentials.
# Copy to `.env` (gitignored) and set real values for any shared/production
# deployment. Safe to leave unset for local dev — docker-compose falls back
# to the dev defaults baked into docker-compose.yml.
DB_NAME=gini_dev_db
DB_USER=gini_user
DB_PASSWORD=change-me
