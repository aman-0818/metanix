# Copy this file to `.env` and fill in real values. Never commit `.env` itself.

# ── Core Django ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Add gini.aionos.ai once this is deployed behind the nginx reverse proxy
# (see nginx/ and docker-compose.yml's nginx/certbot services) -- these three
# are also overridden directly in docker-compose.yml's `backend.environment`
# block for the dockerized stack; update .env values here too for any
# non-compose (bare gunicorn) deployment.
ALLOWED_HOSTS=localhost,127.0.0.1,backend,gini.aionos.ai
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://gini.aionos.ai
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://gini.aionos.ai
SECURE_SSL_REDIRECT=False

# ── Database (only needed if NOT using docker-compose's own DB_* overrides) ─
DB_ENGINE=django.db.backends.postgresql
DB_NAME=gini_dev_db
DB_USER=gini_user
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db
# Wall-clock cap (seconds) on a single SSE streaming chat response.
STREAM_TIMEOUT_SECONDS=300
# Public origin the backend is reachable at, used by Celery tasks (no request
# object) to build absolute media URLs (e.g. generated PPTX links). Leave
# blank behind a same-origin nginx proxy; set for local dev cross-port setups
# e.g. BACKEND_PUBLIC_URL=http://localhost:8000
BACKEND_PUBLIC_URL=http://localhost:8000

# ── Encryption (API-key-at-rest encryption; leave blank to disable) ─────────
ENCRYPTION_KEY=

# ── Dev-only seed admin account (see backend management command create_admin) ─
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ── Local (non-SSO) auth ─────────────────────────────────────────────────────
ALLOW_LOCAL_AUTH=True

# ── Azure AD SSO (leave AZURE_AD_ENABLED=False to skip entirely) ────────────
# Full setup checklist for a real deployment lives in the SSO hardening
# report — this file only documents where each value comes from.

# Master switch. False = the SSO button is hidden and both azure/* endpoints
# return 400. Only set True once every value below is filled in.
AZURE_AD_ENABLED=False

# Azure Portal > Microsoft Entra ID > Overview > "Tenant ID" (a GUID), or
# App registrations > <your app> > Overview > "Directory (tenant) ID".
AZURE_AD_TENANT_ID=<your-tenant-id>

# Azure Portal > Microsoft Entra ID > App registrations > <your app> >
# Overview > "Application (client) ID".
AZURE_AD_CLIENT_ID=<your-client-id>

# Azure Portal > App registrations > <your app> > Certificates & secrets >
# Client secrets > New client secret. Copy the secret VALUE immediately —
# Azure only shows it once. Treat like a password; never commit it.
AZURE_AD_CLIENT_SECRET=<your-client-secret>

# The BACKEND URL Azure redirects the browser back to with ?code=&state=.
# Must exactly match (scheme, host, path, trailing slash) a URI registered
# under App registrations > <your app> > Authentication > "Redirect URIs"
# (platform: Web). This backend route (auth/microsoft/login/callback/, see
# multimodel/urls.py) forwards the code/state on to
# AZURE_AD_FRONTEND_REDIRECT_URI below — it does not render anything itself.
#   Local:      http://localhost:8000/auth/microsoft/login/callback/
#   Production: https://gini.aionos.ai/auth/microsoft/login/callback/
AZURE_AD_REDIRECT_URI=http://localhost:8000/auth/microsoft/login/callback/

# The FRONTEND page (React route in App.tsx) that actually completes login —
# it reads ?code=&state= and calls exchangeAzureCode(). Not itself registered
# with Azure; only AZURE_AD_REDIRECT_URI above is.
#   Local:      http://localhost:5173/auth/callback
#   Production: https://gini.aionos.ai/auth/callback
AZURE_AD_FRONTEND_REDIRECT_URI=http://localhost:5173/auth/callback

# Where Microsoft sends the browser after an Azure-side logout
# (AzureLogoutView / build_logout_url). Must also be registered under the
# same Authentication > Redirect URIs list, and must be a real frontend
# route — the app's login screen lives at "/", not "/login".
#   Local:      http://localhost:5173/
#   Production: https://gini.aionos.ai/
AZURE_AD_LOGOUT_REDIRECT_URI=http://localhost:5173/

# OIDC/Graph scopes requested at login. openid+profile+email are the OIDC
# basics that populate the ID token claims accounts/views.py reads (oid,
# email, given_name, family_name); User.Read is the delegated Graph
# permission — grant it under App registrations > <your app> > API
# permissions > Add a permission > Microsoft Graph > Delegated > User.Read,
# then "Grant admin consent" so users aren't prompted to individually consent.
AZURE_AD_SCOPES=openid profile email User.Read

# If True, local (non-SSO) login stays available for admin accounts even
# once AZURE_AD_ENABLED=True — a break-glass path if the IdP is unreachable.
AZURE_AD_ALLOW_LOCAL_ADMIN=True

# If True, a first-time Azure AD sign-in auto-creates the platform user
# instead of requiring an admin to pre-provision them.
AZURE_AD_AUTO_PROVISION=True

# Enables backend/accounts/graph_client.py calls to Microsoft Graph (e.g.
# for group/role sync beyond what's in the ID token). Requires its own
# Graph API permissions grant if turned on.
AZURE_AD_GRAPH_ENABLED=False
AZURE_AD_GRAPH_SCOPES=User.Read.All

# ── LLM provider API keys (only needed for providers you actually configure) ─
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01
HUGGINGFACE_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:1b

# ── Uploads & throttling ──────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_TYPES=pdf,docx,txt,md,csv,xlsx
THROTTLE_ANON=20/minute
THROTTLE_USER=120/minute
QUEUE_CONCURRENCY=5
QUEUE_MAX_SIZE=100
